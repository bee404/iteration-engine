{
  "name": "iteration-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Personal design-iteration tool: screenshot + feedback in, critique and rationale-backed directions out, on-demand code generation, Turso-persisted round history.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "node --import tsx --test $(find lib -name '*.test.ts')",
    "build:preview-runtime": "node scripts/build-preview-runtime.mjs",
    "contextbridge:sync": "node scripts/contextbridge/sync.mjs --scope github",
    "contextbridge:stage-local": "node scripts/contextbridge/stage-local.mjs",
    "prebuild": "npm run build:preview-runtime",
    "db:migrate": "tsx lib/db/migrate.ts",
    "verify:codegen": "tsx scripts/verify-codegen-postprocess.ts",
    "verify:directions": "tsx scripts/verify-directions.ts"
  },
  "dependencies": {
    "@libsql/client": "0.17.4",
    "@vercel/analytics": "^2.0.1",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sucrase": "3.35.1",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "esbuild": "0.28.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "tsx": "4.23.12",
    "typescript": "6.0.3"
  }
}
