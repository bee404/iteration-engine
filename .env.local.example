# Copy to .env.local for local development. Never commit real values.
# All variables are server-only (read in API routes / server components), per Vercel Hobby convention.

# Demo / fixture replay mode. Set DEMO_MODE=true to replay REAL previously-captured critique,
# directions, and code-gen output (lib/fixtures/) through the existing provider factories instead
# of calling any live model. Checked ahead of every other provider selector, so the whole
# upload -> critique -> directions -> code-streaming flow runs with zero external API calls.
# Leave unset/false for normal live behavior. Optionally pin which captured example to replay with DEMO_FIXTURE=<id>
# (defaults to the first registered fixture).
DEMO_MODE=
DEMO_FIXTURE=

# Single-user access gate for live production. Set both values in Vercel. A live production
# deployment without both credentials fails closed with HTTP 503. Public DEMO_MODE previews
# remain open because demo providers make no external calls.
COQUI_ACCESS_USERNAME=
COQUI_ACCESS_PASSWORD=

# Anthropic Claude (primary critique/direction/code-gen model). Not required to run the app —
# providers fall back to typed mock responses when unset.
ANTHROPIC_API_KEY=

# Force a specific LLM provider regardless of ANTHROPIC_API_KEY: "mock" or "claude". Leave unset
# to auto-select (Claude when ANTHROPIC_API_KEY is set, mock otherwise). LLM_PROVIDER=claude
# without a key fails loudly rather than silently falling back.
LLM_PROVIDER=

# OpenAI GPT-4o (fallback model on Claude validation failure).
OPENAI_API_KEY=

# 21st.dev MCP server, used at generation time only to ground directions in comparable
# layout/pattern references. Not required to run the app — falls back to a typed mock response.
TWENTYFIRST_API_KEY=
